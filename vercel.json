{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://manwall-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "experimentalServices": {
    "web": {
      "routePrefix": "/",
      "framework": "vite"
    }
  }
}
