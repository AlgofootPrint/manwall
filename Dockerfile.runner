FROM ghcr.io/foundry-rs/foundry@sha256:043752653d5be351c71709091b3db97c4421c907eb40ea294195e7f532aadf46 AS foundry
FROM ethereum/solc@sha256:b116bf835554d40c501feab0b2c943a8c5eec003b804bcc5b326b85c93da00c2 AS solc

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git python3 python3-venv \
  && rm -rf /var/lib/apt/lists/*

COPY --from=foundry /usr/local/bin/forge /usr/local/bin/forge
COPY --from=foundry /usr/local/bin/cast /usr/local/bin/cast
COPY --from=foundry /usr/local/bin/anvil /usr/local/bin/anvil
COPY --from=solc /usr/bin/solc /usr/local/bin/solc

RUN python3 -m venv /opt/slither \
  && /opt/slither/bin/pip install --no-cache-dir slither-analyzer==0.11.5 \
  && ln -s /opt/slither/bin/slither /usr/local/bin/slither

WORKDIR /runner

COPY runner.package.json ./package.json
RUN npm install --no-package-lock

COPY server ./server
COPY tsconfig.node.json ./

ENTRYPOINT ["node", "--import", "tsx", "server/containerRunner.ts"]
